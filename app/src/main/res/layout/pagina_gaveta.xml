<?xml version="1.0" encoding="utf-8"?>
<com.github.dimezis.blurview.BlurView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blurViewGaveta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#20FFFFFF"> <!-- Transparência leve branca/acrílica estilo iOS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="48dp">

        <EditText
            android:id="@+id/etBuscaGaveta"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_busca_arredondada"
            android:hint="Pesquisar aplicativos..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0FFFFFF"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerGavetaPagina"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:paddingBottom="24dp" />

    </LinearLayout>

</com.github.dimezis.blurview.BlurView>